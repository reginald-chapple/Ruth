  "accountId": "{{accountId}}",
  "totalAmount": 1200.00,
  "currencyCode": "USD",
  "frequency": "Monthly",
  "startDate": "2026-01-01",
  "endDate": "2026-12-31",
  "notes": "Annual scholarship pledge"
}

### W4-S1: List Pledges & Analytics
GET {{baseUrl}}/api/finance/pledges
Authorization: Bearer {{token}}

### W4-S1: Get Pledge Analytics
GET {{baseUrl}}/api/finance/pledges/analytics?currencyCode=USD
Authorization: Bearer {{token}}

