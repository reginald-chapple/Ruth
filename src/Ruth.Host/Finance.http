@batchId = 0196f840-0007-7000-8000-000000000407
@transactionId = 0196f840-0008-7000-8000-000000000408
@imageId = 0196f840-000c-7000-8000-00000000040c
@pledgeId = 0196f840-0002-7000-8000-000000000402
