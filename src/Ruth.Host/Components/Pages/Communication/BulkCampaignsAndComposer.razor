@page "/communication/campaigns"
@rendermode InteractiveServer

<PageTitle>Bulk Communications &amp; Email Builder</PageTitle>

<div class="ruth-page-header">
    <h1>Bulk Communications &amp; Structured Email Composer</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="ruth-kiosk-grid">
        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Compose Bulk Email or SMS Campaign</h2>
                <FluentSelect TOption="CommunicationTemplateResponse"
                              TValue="Guid"
                              Label="Load From Saved Template"
                              Items="@_templates"
                              OptionText="@(static t => $"{t.Name} ({t.Channel})")"
                              OptionValue="@(static t => t.Id)"
                              Value="@_selectedTemplateId"
                              ValueChanged="@OnTemplateSelectedAsync" />
                <FluentTextInput @bind-Value="_title" Label="Campaign Title" Placeholder="Autumn Community Update" />
                <FluentSelect TOption="string"
                              TValue="string"
                              Label="Subscription Topic"
                              Items="@_topics"
                              OptionText="@(static t => t)"
                              OptionValue="@(static t => t)"
                              @bind-Value="_topicKey" />
                <FluentTextInput @bind-Value="_subject" Label="Email Subject (Merge Enabled)" />
                <FluentTextInput @bind-Value="_heroHeading" Label="Hero Section Heading" />
                <FluentTextArea @bind-Value="_richBodyMarkup" Label="Rich Body Markup ({{ RecipientName }} supported)" Rows="3" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentTextInput @bind-Value="_ctaLabel" Label="CTA Button Label" />
                    <FluentTextInput @bind-Value="_ctaUrl" Label="CTA Button URL" />
                </FluentStack>
                <FluentTextArea @bind-Value="_recipientsCsv"
                                Label="Recipient Emails (comma-separated)"
                                Rows="2" />

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@PreviewComposerAsync">
                        Preview HTML
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateDraftCampaignAsync">
                        Save Draft Campaign
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Rendered Email Preview</h2>
                @if (_preview is null)
                {
                    <p>Click <strong>Preview HTML</strong> to compile structured sections with merge tokens.</p>
                }
                else
                {
                    <div><strong>Subject:</strong> @_preview.RenderedSubject</div>
                    <div class="ruth-email-preview-box">
                        @((MarkupString)_preview.RenderedHtml)
                    </div>
                }
            </FluentStack>
        </FluentCard>
    </div>

    <CampaignSummaryGridCard Campaigns="@_campaigns"
                             OnSubmit="@SubmitCampaignAsync"
                             OnApprove="@ApproveCampaignAsync"
                             OnReject="@RejectCampaignAsync"
                             OnDispatch="@DispatchCampaignAsync" />
</FluentStack>
