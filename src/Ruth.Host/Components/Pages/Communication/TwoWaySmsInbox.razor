@page "/communication/sms-inbox"
@rendermode InteractiveServer

<PageTitle>Two-Way SMS Conversations &amp; Keywords</PageTitle>

<div class="ruth-page-header">
    <h1>Two-Way SMS Conversations Inbox &amp; Keyword Pipelines</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="ruth-kiosk-grid">
        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Conversations (@_conversations.Count)</h2>
                @if (_conversations.Count == 0)
                {
                    <p>No inbound or outbound SMS conversations yet.</p>
                }
                else
                {
                    @foreach (var conv in _conversations)
                    {
                        <div @key="@($"{conv.SystemPhoneNumberId}:{conv.ParticipantPhoneNumber}")"
                             class="ruth-kiosk-member-row">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                                <strong>@conv.ParticipantDisplayName</strong>
                                <span>(@conv.ParticipantPhoneNumber)</span>
                                @if (conv.UnreadInboundCount > 0)
                                {
                                    <span class="ruth-room-status-pill">@conv.UnreadInboundCount unread</span>
                                }
                            </FluentStack>
                            <div>@conv.LastMessagePreview</div>
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          OnClick="@(() => SelectConversationAsync(conv))">
                                Open Thread
                            </FluentButton>
                        </div>
                    }
                }
            </FluentStack>
        </FluentCard>

        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Conversation Thread</h2>
                @if (_selectedConversation is null)
                {
                    <p>Select a conversation thread on the left to read messages and send a 1-to-1 reply.</p>
                }
                else
                {
                    <div>
                        <strong>@_selectedConversation.ParticipantDisplayName</strong> via @_selectedConversation.SystemPhoneNumber
                    </div>
                    <div class="ruth-sms-thread">
                        @foreach (var msg in _threadMessages)
                        {
                            <div @key="msg.Id"
                                 class="ruth-sms-bubble @(msg.Direction != SmsMessageDirection.Inbound ? "ruth-sms-bubble-outbound" : string.Empty)">
                                <div><strong>@msg.Direction:</strong> @msg.MessageBody</div>
                            </div>
                        }
                    </div>
                    <FluentTextArea @bind-Value="_replyBody" Label="1-to-1 SMS Reply" Rows="2" />
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SendReplyAsync">
                        Send SMS Reply
                    </FluentButton>
                }
            </FluentStack>
        </FluentCard>
    </div>

    <SmsPipelineConfiguratorCard Pipelines="@_pipelines" OnCreatePipeline="@CreatePipelineAsync" />
</FluentStack>
