@page "/reporting/reports"
@rendermode InteractiveServer

<PageTitle>Reports &amp; Merge Templates — Ruth RMS</PageTitle>

<div class="ruth-page-header">
    <h1>Reports, CSV/Excel Export &amp; HTML/DOCX Merge Templates</h1>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadAsync">Refresh</FluentButton>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>1. Create Report (IFieldSelectPlugin Columns)</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_reportName" Label="Report Name" />
                <FluentTextInput @bind-Value="_reportEntityType" Label="Entity Type Key" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateReportAsync">
                    Create Report
                </FluentButton>
            </FluentStack>
            @foreach (var r in _reports)
            {
                <div class="ruth-kiosk-member-row" @key="r.Id">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                        <strong>@r.Name</strong>
                        <span class="ruth-room-status-pill">@r.EntityTypeKey · @r.Fields.Count cols</span>
                        <FluentButton Size="ButtonSize.Small" OnClick="@(() => RunReportAsync(r.Id))">
                            Preview
                        </FluentButton>
                        <a href="/api/reporting/reports/@r.Id/export?format=Csv" target="_blank" class="ruth-header-link">CSV</a>
                        <a href="/api/reporting/reports/@r.Id/export?format=Excel" target="_blank" class="ruth-header-link">Excel (.xlsx)</a>
                    </FluentStack>
                </div>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>2. HTML &amp; DOCX Merge Document Templates</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_templateName" Label="Template Name" />
                <FluentTextInput @bind-Value="_templateBody" Label="Safe Merge Token Body" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateTemplateAsync">
                    Create Merge Template
                </FluentButton>
            </FluentStack>
            @foreach (var t in _templates)
            {
                <div class="ruth-kiosk-member-row" @key="t.Id">
                    <strong>@t.Name</strong>
                    <span class="ruth-room-status-pill">@t.Format</span>
                </div>
            }
        </FluentStack>
    </FluentCard>

    @if (_preview is not null)
    {
        <FluentCard Padding="@Padding.All4">
            <h3>Preview: @_preview.ReportName (@_preview.TotalRows rows)</h3>
            <p class="ruth-cms-empty-note">Columns: @string.Join(", ", _preview.Columns)</p>
        </FluentCard>
    }
</FluentStack>
