@page "/reporting/metrics"
@rendermode InteractiveServer

<PageTitle>Operational Metrics &amp; Dynamic Charts</PageTitle>

<div class="ruth-page-header">
    <h1>Operational Metrics Entry &amp; Dynamic Charts</h1>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadAsync">Refresh</FluentButton>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>1. Define Operational Metric</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_metricTitle" Label="Metric Title" />
                <FluentTextInput @bind-Value="_metricKey" Label="Metric Key" />
                <FluentTextInput @bind-Value="_unitLabel" Label="Unit" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateMetricAsync">
                    Create Metric
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>2. Configured Metrics &amp; Quick Entry (@_metrics.Count)</h2>
            @foreach (var m in _metrics)
            {
                <div class="ruth-kiosk-member-row" @key="m.Id">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                        <strong>@m.Title (@m.MetricKey)</strong>
                        <span class="ruth-room-status-pill">@m.SourceType · @(m.UnitLabel ?? "Count")</span>
                        <FluentButton Size="ButtonSize.Small" OnClick="@(() => RecordSampleAsync(m.Id))">
                            + Log Value (@_entryValue)
                        </FluentButton>
                        <FluentButton Size="ButtonSize.Small"
                                      Appearance="ButtonAppearance.Outline"
                                      OnClick="@(() => LoadChartAsync(m.Id))">
                            View DynamicChart
                        </FluentButton>
                    </FluentStack>
                </div>
            }
        </FluentStack>
    </FluentCard>

    @if (_chart is not null)
    {
        <FluentCard Padding="@Padding.All4">
            <h3>@_chart.MetricTitle (@_chart.Granularity)</h3>
            <p class="ruth-cms-empty-note">
                Latest: <strong>@_chart.LatestValue</strong> · Total: <strong>@_chart.TotalValue</strong> · Avg: <strong>@_chart.AverageValue</strong>
            </p>
            @foreach (var series in _chart.Series)
            {
                <div>
                    <strong>@series.SeriesName</strong>
                    <ul>
                        @foreach (var pt in series.Points)
                        {
                            <li>@pt.Label: @pt.MeasureValue @(pt.GoalValue is not null ? $"(Goal: {pt.GoalValue})" : "")</li>
                        }
                    </ul>
                </div>
            }
        </FluentCard>
    }
</FluentStack>
