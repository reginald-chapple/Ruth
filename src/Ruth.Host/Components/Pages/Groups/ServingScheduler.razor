@page "/groups/scheduler"
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher

<PageTitle>Shift &amp; Volunteer Scheduler</PageTitle>

<div class="ruth-page-header">
    <h1>Coordinator Shift &amp; Volunteer Schedule Grid</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
            <FluentTextInput @bind-Value="_groupIdText" Label="Serving Group ID" Placeholder="GUID" />
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@LoadGridAsync">
                Load 4-Week Grid
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@AutoPopulateAsync">
                Auto-Populate Next Week
            </FluentButton>
        </FluentStack>
    </FluentCard>

    @if (_grid is not null)
    {
        <FluentCard Padding="@Padding.All4">
            <h2>@_grid.GroupName (@_grid.StartDate.ToString("yyyy-MM-dd") to @_grid.EndDate.ToString("yyyy-MM-dd"))</h2>
            <FluentDataGrid Items="@_grid.Slots.AsQueryable()">
                <PropertyColumn Property="@(static s => s.OccurrenceDate)" Title="Date" />
                <PropertyColumn Property="@(static s => s.LocationName)" Title="Location" />
                <PropertyColumn Property="@(static s => s.ConfirmedCount)" Title="Confirmed" />
                <PropertyColumn Property="@(static s => s.PendingCount)" Title="Pending" />
                <PropertyColumn Property="@(static s => s.DesiredCapacity)" Title="Desired" />
                <PropertyColumn Property="@(static s => s.CapacityStatus)" Title="Health" />
            </FluentDataGrid>
        </FluentCard>

        <FluentCard Padding="@Padding.All4">
            <h3>Eligible Volunteer Candidates</h3>
            <FluentDataGrid Items="@_grid.Candidates.AsQueryable()">
                <PropertyColumn Property="@(static c => c.PersonId)" Title="Person ID" />
                <PropertyColumn Property="@(static c => c.GroupRoleName)" Title="Role" />
                <PropertyColumn Property="@(static c => c.HasBlackoutOnDate)" Title="Blackout" />
                <PropertyColumn Property="@(static c => c.HasRequirementGap)" Title="Req Gap" />
                <PropertyColumn Property="@(static c => c.IsEligible)" Title="Eligible" />
            </FluentDataGrid>
        </FluentCard>
    }
</FluentStack>

@code {
    private ServingScheduleGridResponse? _grid;
    private string _groupIdText = string.Empty;
    private string? _statusMessage;
    private bool _isError;

    private async Task LoadGridAsync()
    {
        _statusMessage = null;
        _isError = false;
        if (!Guid.TryParse(_groupIdText.Trim(), out var groupId))
        {
            _isError = true;
            _statusMessage = "Enter a valid Serving Group GUID.";
            return;
        }

        var start = DateOnly.FromDateTime(DateTime.UtcNow);
        var result = await QueryDispatcher.QueryAsync<
            GetServingScheduleGridQuery,
            ServingScheduleGridResponse
        >(new GetServingScheduleGridQuery(groupId, start, start.AddDays(28)));
        if (result.IsSuccess)
        {
            _grid = result.Value;
            return;
        }

        _isError = true;
        _statusMessage = result.PrimaryError.Description;
    }

    private async Task AutoPopulateAsync()
    {
        if (!Guid.TryParse(_groupIdText.Trim(), out var groupId))
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var nextOccurrenceDate = today.AddDays(7);

        var result = await CommandDispatcher.SendAsync<
            AutoPopulateServingScheduleCommand,
            AutoPopulateScheduleResponse
        >(new AutoPopulateServingScheduleCommand(groupId, nextOccurrenceDate));
        if (result.IsSuccess)
        {
            _statusMessage = $"Auto-populated {result.Value.VolunteersScheduled} volunteers for {nextOccurrenceDate:yyyy-MM-dd}.";
            _isError = false;
            await LoadGridAsync();
            return;
        }

        _isError = true;
        _statusMessage = result.PrimaryError.Description;
    }
}
