@page "/admin/core/defined-types"
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher
@inject NavigationManager NavigationManager

<PageTitle>Defined Types</PageTitle>

<div class="ruth-page-header">
    <h1>Defined Types</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
            <FluentTextInput @bind-Value="_newName" Label="New Defined Type Name" Placeholder="e.g., Shirt Sizes" />
            <FluentTextInput @bind-Value="_newDescription" Label="Description" />
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateAsync">
                Add Defined Type
            </FluentButton>
        </FluentStack>
    </FluentCard>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
        <FluentTextInput @bind-Value="_search" Label="Search" Placeholder="Filter by name..." />
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@LoadAsync">Filter</FluentButton>
    </FluentStack>

    <FluentDataGrid Items="@_items.AsQueryable()">
        <PropertyColumn Property="@(static d => d.Name)" Title="Name" Sortable="true" />
        <PropertyColumn Property="@(static d => d.Description)" Title="Description" />
        <PropertyColumn Property="@(static d => d.ValueCount)" Title="Values" />
        <PropertyColumn Property="@(static d => d.IsActive)" Title="Active" />
        <TemplateColumn Title="Actions">
            <FluentButton Size="ButtonSize.Small"
                          Appearance="ButtonAppearance.Primary"
                          OnClick="@(() => NavigationManager.NavigateTo($"/admin/core/defined-types/{context.Id:D}"))">
                Manage Values
            </FluentButton>
            <FluentButton Size="ButtonSize.Small"
                          Disabled="@context.IsSystem"
                          OnClick="@(() => DeleteAsync(context.Id))">
                Delete
            </FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
</FluentStack>

@code {
    private List<DefinedTypeSummaryResponse> _items = [];
    private string _search = string.Empty;
    private string _newName = string.Empty;
    private string _newDescription = string.Empty;
    private string? _statusMessage;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await QueryDispatcher.QueryAsync<GetDefinedTypesQuery, IReadOnlyList<DefinedTypeSummaryResponse>>(
            new GetDefinedTypesQuery(SearchTerm: string.IsNullOrWhiteSpace(_search) ? null : _search)
        );
        if (result.IsSuccess)
        {
            _items = [.. result.Value];
        }
    }

    private async Task CreateAsync()
    {
        _statusMessage = null;
        _isError = false;
        var result = await CommandDispatcher.SendAsync<CreateDefinedTypeCommand, DefinedTypeDetailResponse>(
            new CreateDefinedTypeCommand(_newName, _newDescription)
        );
        if (result.IsSuccess)
        {
            _newName = string.Empty;
            _newDescription = string.Empty;
            _statusMessage = $"Created Defined Type '{result.Value.Name}'.";
            await LoadAsync();
        }
        else
        {
            _isError = true;
            _statusMessage = result.PrimaryError.Description;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        _statusMessage = null;
        _isError = false;
        var result = await CommandDispatcher.SendAsync<DeleteDefinedTypeCommand, bool>(
            new DeleteDefinedTypeCommand(id)
        );
        if (result.IsSuccess)
        {
            _statusMessage = "Defined Type deleted.";
            await LoadAsync();
        }
        else
        {
            _isError = true;
            _statusMessage = result.PrimaryError.Description;
        }
    }
}
