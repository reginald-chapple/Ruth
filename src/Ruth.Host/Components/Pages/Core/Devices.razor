@page "/admin/core/devices"
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher

<PageTitle>Devices</PageTitle>

<div class="ruth-page-header">
    <h1>Physical Devices</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>Register Device (Kiosk / Printer / Tablet)</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_name" Label="Name" Placeholder="Lobby Kiosk 1" />
                <FluentTextInput @bind-Value="_ipAddress" Label="IP Address / Host" Placeholder="10.0.1.25" />
                <FluentSelect TOption="DevicePrintFrom"
                              TValue="DevicePrintFrom"
                              Label="Print From"
                              Items="@_printFromOptions"
                              OptionText="@(static p => p.ToString())"
                              OptionValue="@(static p => p)"
                              @bind-Value="_printFrom" />
                <FluentSelect TOption="KioskType"
                              TValue="KioskType"
                              Label="Kiosk Type"
                              Items="@_kioskTypes"
                              OptionText="@(static k => k.ToString())"
                              OptionValue="@(static k => k)"
                              @bind-Value="_kioskType" />
                <FluentCheckbox @bind-Value="_hasCamera" Label="Has Camera" />
            </FluentStack>
            <div>
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateAsync">
                    Register Device
                </FluentButton>
            </div>
        </FluentStack>
    </FluentCard>

    <FluentDataGrid Items="@_devices.AsQueryable()">
        <PropertyColumn Property="@(static d => d.Name)" Title="Name" Sortable="true" />
        <PropertyColumn Property="@(static d => d.IpAddress)" Title="IP / Host" />
        <PropertyColumn Property="@(static d => d.PrintFrom)" Title="Print From" />
        <PropertyColumn Property="@(static d => d.KioskType)" Title="Kiosk Type" />
        <PropertyColumn Property="@(static d => d.IsActive)" Title="Active" />
        <TemplateColumn Title="Actions">
            <FluentButton Size="ButtonSize.Small" OnClick="@(() => DeleteAsync(context.Id))">
                Delete
            </FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
</FluentStack>

@code {
    private static readonly Guid DefaultCheckInKioskTypeId = new("a1b2c3d4-0001-4000-8000-000000000001");
    private static readonly DevicePrintFrom[] _printFromOptions = [DevicePrintFrom.Client, DevicePrintFrom.Server];
    private static readonly KioskType[] _kioskTypes = [KioskType.Browser, KioskType.IPad, KioskType.WindowsApp];

    private List<DeviceResponse> _devices = [];
    private string _name = string.Empty;
    private string _ipAddress = string.Empty;
    private DevicePrintFrom _printFrom = DevicePrintFrom.Client;
    private KioskType _kioskType = KioskType.Browser;
    private bool _hasCamera;
    private string? _statusMessage;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await QueryDispatcher.QueryAsync<GetDevicesQuery, IReadOnlyList<DeviceResponse>>(
            new GetDevicesQuery()
        );
        if (result.IsSuccess)
        {
            _devices = [.. result.Value];
        }
    }

    private async Task CreateAsync()
    {
        _statusMessage = null;
        _isError = false;
        var result = await CommandDispatcher.SendAsync<CreateDeviceCommand, DeviceResponse>(
            new CreateDeviceCommand(
                _name,
                DefaultCheckInKioskTypeId,
                IpAddress: string.IsNullOrWhiteSpace(_ipAddress) ? null : _ipAddress,
                PrintFrom: _printFrom,
                HasCamera: _hasCamera,
                KioskType: _kioskType
            )
        );
        if (result.IsSuccess)
        {
            _name = string.Empty;
            _ipAddress = string.Empty;
            _statusMessage = $"Registered device '{result.Value.Name}'.";
            await LoadAsync();
        }
        else
        {
            _isError = true;
            _statusMessage = result.PrimaryError.Description;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await CommandDispatcher.SendAsync<DeleteDeviceCommand, bool>(
            new DeleteDeviceCommand(id)
        );
        if (result.IsSuccess)
        {
            _statusMessage = "Device deleted.";
            await LoadAsync();
        }
    }
}
