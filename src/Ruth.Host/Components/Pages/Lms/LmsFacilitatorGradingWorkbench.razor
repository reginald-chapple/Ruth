@page "/lms/grading"
@rendermode InteractiveServer

<PageTitle>Facilitator Grading Queue</PageTitle>

<div class="ruth-page-header">
    <h1>Facilitator Grading Queue</h1>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadAsync">Refresh</FluentButton>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentCard Padding="@Padding.All4">
    <h2>Pending Submissions (@_queue.Count)</h2>
    @if (_queue.Count == 0)
    {
        <p class="ruth-cms-empty-note">No submissions are currently awaiting facilitator grading.</p>
    }
    else
    {
        @foreach (var item in _queue)
        {
            <div class="ruth-kiosk-member-row" @key="item.Id">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                    <strong>@item.ActivityName</strong>
                    <span class="ruth-room-status-pill">@item.ComponentType · Max @item.PointsPossible pts</span>
                    <FluentButton Size="ButtonSize.Small"
                                  Appearance="ButtonAppearance.Primary"
                                  OnClick="@(() => AwardFullCreditAsync(item))">
                        Award Full Credit (@item.PointsPossible)
                    </FluentButton>
                </FluentStack>
            </div>
        }
    }
</FluentCard>
