@page "/admin/crm/settings"
@inject IQueryDispatcher QueryDispatcher
@inject ICommandDispatcher CommandDispatcher

<PageTitle>CRM Settings</PageTitle>

<div class="ruth-page-header">
    <h1>CRM Signals, Badges &amp; Assessments</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>Signal Types</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                <FluentTextInput @bind-Value="_signalName" Label="Name" Placeholder="Allergy Alert" />
                <FluentTextInput @bind-Value="_signalColor" Label="Color" Placeholder="#D13438" />
                <FluentTextInput @bind-Value="_signalIcon" Label="Icon" Placeholder="warning" />
                <FluentTextInput @bind-Value="_signalOrderText" Label="Priority Order" Placeholder="0" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateSignalTypeAsync">
                    Add Signal Type
                </FluentButton>
            </FluentStack>
            <FluentDataGrid Items="@_signalTypes.AsQueryable()">
                <PropertyColumn Property="@(static s => s.Order)" Title="Priority" Sortable="true" />
                <PropertyColumn Property="@(static s => s.Name)" Title="Name" />
                <PropertyColumn Property="@(static s => s.SignalColor)" Title="Color" />
                <PropertyColumn Property="@(static s => s.SignalIcon)" Title="Icon" />
            </FluentDataGrid>
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <h2>Configured Profile Badges (@_badges.Count)</h2>
        <FluentDataGrid Items="@_badges.AsQueryable()">
            <PropertyColumn Property="@(static b => b.Order)" Title="Order" />
            <PropertyColumn Property="@(static b => b.Name)" Title="Name" />
            <PropertyColumn Property="@(static b => b.BadgeComponentKey)" Title="Component Key" />
            <PropertyColumn Property="@(static b => b.IsActive)" Title="Active" />
        </FluentDataGrid>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <h2>Assessment Types (@_assessmentTypes.Count)</h2>
        <FluentDataGrid Items="@_assessmentTypes.AsQueryable()">
            <PropertyColumn Property="@(static a => a.Title)" Title="Title" />
            <PropertyColumn Property="@(static a => a.Key)" Title="Key" />
            <PropertyColumn Property="@(static a => a.MinimumDaysToRetake)" Title="Retake Cooldown (Days)" />
            <PropertyColumn Property="@(static a => a.IsSystem)" Title="System" />
        </FluentDataGrid>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <h2>Background Check Packages (@_packages.Count)</h2>
        <FluentDataGrid Items="@_packages.AsQueryable()">
            <PropertyColumn Property="@(static p => p.ProviderKey)" Title="Provider" />
            <PropertyColumn Property="@(static p => p.Slug)" Title="Package Slug" />
            <PropertyColumn Property="@(static p => p.Name)" Title="Package Name" />
        </FluentDataGrid>
    </FluentCard>
</FluentStack>

@code {
    private List<SignalTypeResponse> _signalTypes = [];
    private List<BadgeDefinitionResponse> _badges = [];
    private List<AssessmentTypeResponse> _assessmentTypes = [];
    private List<BackgroundCheckPackageResponse> _packages = [];
    private string _signalName = string.Empty;
    private string _signalColor = "#D13438";
    private string _signalIcon = "flag";
    private string _signalOrderText = "0";
    private string? _statusMessage;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var signals = await QueryDispatcher.QueryAsync<GetSignalTypesQuery, IReadOnlyList<SignalTypeResponse>>(
            new GetSignalTypesQuery()
        );
        if (signals.IsSuccess)
        {
            _signalTypes = [.. signals.Value];
        }

        var badges = await QueryDispatcher.QueryAsync<GetBadgeDefinitionsQuery, IReadOnlyList<BadgeDefinitionResponse>>(
            new GetBadgeDefinitionsQuery()
        );
        if (badges.IsSuccess)
        {
            _badges = [.. badges.Value];
        }

        var assessments = await QueryDispatcher.QueryAsync<GetAssessmentTypesQuery, IReadOnlyList<AssessmentTypeResponse>>(
            new GetAssessmentTypesQuery()
        );
        if (assessments.IsSuccess)
        {
            _assessmentTypes = [.. assessments.Value];
        }

        var packages = await QueryDispatcher.QueryAsync<GetBackgroundCheckPackagesQuery, IReadOnlyList<BackgroundCheckPackageResponse>>(
            new GetBackgroundCheckPackagesQuery()
        );
        if (packages.IsSuccess)
        {
            _packages = [.. packages.Value];
        }
    }

    private async Task CreateSignalTypeAsync()
    {
        var order = int.TryParse(
            _signalOrderText,
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsed
        )
            ? parsed
            : 0;
        var result = await CommandDispatcher.SendAsync<CreateSignalTypeCommand, SignalTypeResponse>(
            new CreateSignalTypeCommand(_signalName, _signalColor, _signalIcon, Order: order)
        );
        if (result.IsSuccess)
        {
            _signalName = string.Empty;
            _isError = false;
            _statusMessage = $"Created signal type '{result.Value.Name}'.";
            await LoadAsync();
        }
        else
        {
            _isError = true;
            _statusMessage = result.PrimaryError.Description;
        }
    }
}
