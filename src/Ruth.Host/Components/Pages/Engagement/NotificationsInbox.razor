@page "/engagement/notifications"
@rendermode InteractiveServer

<PageTitle>Notification Bell Inbox — Ruth RMS</PageTitle>

<div class="ruth-page-header">
    <h1>Notifications &amp; Digest Inbox (@_notifications.Count(static n => !n.IsRead) Unread)</h1>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadAsync">Refresh</FluentButton>
</div>

<FluentCard Padding="@Padding.All4">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
        @if (_notifications.Count == 0)
        {
            <p>You're all caught up — no notifications right now.</p>
        }
        @foreach (var item in _notifications)
        {
            <div class="ruth-kiosk-member-row" @key="item.Id">
                <strong>@item.Title</strong>
                <span class="ruth-room-status-pill">@item.Category · @(item.IsRead ? "Read" : "Unread")</span>
                <span>@item.Message</span>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                    {
                        <a href="@item.ActionUrl">Open</a>
                    }
                    @if (!item.IsRead)
                    {
                        <FluentButton Size="ButtonSize.Small" OnClick="@(() => MarkReadAsync(item.Id))">
                            Mark Read
                        </FluentButton>
                    }
                </FluentStack>
            </div>
        }
    </FluentStack>
</FluentCard>
