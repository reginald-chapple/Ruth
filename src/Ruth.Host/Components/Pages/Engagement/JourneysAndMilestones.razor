@page "/engagement/journeys"
@rendermode InteractiveServer

<PageTitle>Journeys &amp; Milestones — Ruth RMS</PageTitle>

<div class="ruth-page-header">
    <h1>Journeys (Milestone Programs) &amp; Constituent Progress</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>Configure Journey Program</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_programName" Label="Program Name" />
                <FluentTextInput @bind-Value="_programSlug" Label="Program Slug" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateDefaultProgramAsync">
                    Create 3-Step Leadership Journey
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>Active Journey Programs (@_programs.Count)</h2>
            @foreach (var prog in _programs)
            {
                <div class="ruth-kiosk-member-row" @key="prog.Id">
                    <strong>@prog.Name (@prog.CompletionMode)</strong>
                    <span>
                        Milestones:
                        @string.Join(" -> ", prog.MilestoneTypes.Select(static m => $"{m.Name} [{m.Code}]"))
                    </span>
                </div>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>Program Completions (@_completions.Count)</h2>
            @foreach (var comp in _completions)
            {
                <div class="ruth-kiosk-member-row" @key="comp.Id">
                    <strong>@comp.JourneyProgramName</strong>
                    <span>Person: @comp.PersonId · Completed: @comp.CompletedDate.ToString("yyyy-MM-dd")</span>
                </div>
            }
        </FluentStack>
    </FluentCard>
</FluentStack>
