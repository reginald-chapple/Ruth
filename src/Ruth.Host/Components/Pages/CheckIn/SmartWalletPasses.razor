@page "/checkin/wallet-passes"
@rendermode InteractiveServer

<PageTitle>Smart Wallet Passes — Ruth RMS</PageTitle>

<div class="ruth-page-header">
    <h1>Smart Wallet Passes (Apple .pkpass &amp; Google Wallet)</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div class="ruth-kiosk-grid">
        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Issue or Update Member / Event Pass</h2>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentSelect TOption="WalletPassTemplateResponse"
                                  TValue="Guid"
                                  Label="Pass Template"
                                  Items="@_templates"
                                  OptionText="@(static t => $"{t.Name} ({t.CardStyle})")"
                                  OptionValue="@(static t => t.Id)"
                                  @bind-Value="_selectedTemplateId" />
                    <FluentTextInput @bind-Value="_personIdInput"
                                     Label="Participant Person GUID"
                                     Placeholder="0196f4a0-..." />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentTextInput @bind-Value="_holderName" Label="Cardholder Name" Placeholder="Alex Rivera" />
                    <FluentTextInput @bind-Value="_membershipTier" Label="Membership Tier" Placeholder="Family Gold" />
                    <FluentTextInput @bind-Value="_punchBalanceInput" Label="Punch / Credit Balance" Placeholder="10" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentTextInput @bind-Value="_nextShiftSummary"
                                     Label="Next Shift / Booking"
                                     Placeholder="Sat 9:00 AM Welcome Desk" />
                    <FluentTextInput @bind-Value="_eventTicketSummary"
                                     Label="Event Ticket"
                                     Placeholder="Annual Summit - Seat B12" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                    <FluentCheckbox @bind-Value="_sendClaimNotification"
                                    Label="Email / SMS Pass Claim Link via Outbox" />
                    <FluentTextInput @bind-Value="_recipientEmail"
                                     Label="Optional Claim Email"
                                     Placeholder="member@example.org" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@IssuePassAsync">
                        Issue Smart Wallet Pass
                    </FluentButton>
                    @if (_selectedPass is not null && _selectedPass.Status == IssuedWalletPassStatus.Active)
                    {
                        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@UpdateSelectedPassFieldsAsync">
                            Push Live Update to Pass
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@RevokeSelectedPassAsync">
                            Revoke Pass
                        </FluentButton>
                    }
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <WalletPassPreviewCard SvgMarkup="@_previewSvg"
                               SelectedPass="@_selectedPass"
                               LastClaimUrl="@_lastClaimUrl" />
    </div>

    <div class="ruth-kiosk-grid">
        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Issued Smart Wallet Passes (@_issuedPasses.Count)</h2>
                @if (_issuedPasses.Count == 0)
                {
                    <p>No passes issued yet. Issue a pass above to generate a WLT-* Kiosk scan token and claim link.</p>
                }
                else
                {
                    @foreach (var pass in _issuedPasses)
                    {
                        <div class="ruth-kiosk-member-row">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                                <strong>@(pass.DynamicFields.HolderDisplayName ?? "Member")</strong>
                                <span class="ruth-room-status-pill">@pass.ScanToken</span>
                                <span class="ruth-room-status-pill">@pass.Status (Rev @pass.Revision)</span>
                                <FluentButton Appearance="ButtonAppearance.Outline"
                                              OnClick="@(() => SelectIssuedPassAsync(pass))">
                                    Inspect &amp; Preview
                                </FluentButton>
                            </FluentStack>
                        </div>
                    }
                }
            </FluentStack>
        </FluentCard>

        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                <h2>Sub-50ms Kiosk Barcode Scan Verifier</h2>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    <FluentTextInput @bind-Value="_scanTokenInput"
                                     Label="Scanned WLT-* Token"
                                     Placeholder="WLT-..." />
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@VerifyKioskScanAsync">
                        Simulate Kiosk Scan
                    </FluentButton>
                </FluentStack>
                @if (_lastScanResult is not null)
                {
                    <p>
                        Resolved <strong>@(_lastScanResult.Pass.DynamicFields.HolderDisplayName ?? "Holder")</strong>
                        (Person <code>@_lastScanResult.PersonId</code>) in
                        <strong>@_lastScanResult.ResolutionMilliseconds ms</strong>.
                    </p>
                }
            </FluentStack>
        </FluentCard>
    </div>
</FluentStack>
