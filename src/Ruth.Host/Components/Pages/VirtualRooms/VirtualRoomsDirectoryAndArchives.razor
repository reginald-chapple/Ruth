@page "/virtual-rooms"
@rendermode InteractiveServer

<PageTitle>Virtual Rooms, Dwell Attendance &amp; Recordings — Ruth RMS</PageTitle>

<div class="ruth-page-header">
    <h1>Embedded LiveKit Virtual Rooms, Hybrid Sessions &amp; Auto-Attendance</h1>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadAsync">
        Refresh Rooms
    </FluentButton>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                      AllowDismiss="true">
        @_statusMessage
    </FluentMessageBar>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>1. Provision Embedded VirtualRoom</h2>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                <FluentTextInput @bind-Value="_roomName" Label="Room Name" />
                <FluentTextInput @bind-Value="_roomSlug" Label="Room Slug" />
                <FluentTextInput @bind-Value="_dwellSecondsInput" Label="Min Dwell Seconds" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CreateRoomAsync">
                    Create Virtual Room
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>2. Active Rooms (@_rooms.Count)</h2>
            @foreach (var room in _rooms)
            {
                <div class="ruth-kiosk-member-row" @key="room.Id">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Wrap="true">
                        <strong>@room.Name (@room.Slug)</strong>
                        <span class="ruth-room-status-pill">@room.ContextKind · Dwell ≥ @(room.MinimumAttendanceDwellSeconds)s</span>
                        <a href="/virtual-rooms/stage/@room.Slug" class="ruth-header-link">Open LiveKit Stage</a>
                        <FluentButton Size="ButtonSize.Small"
                                      OnClick="@(() => StartSessionNowAsync(room.Id, room.Name))">
                            Start Live Session
                        </FluentButton>
                    </FluentStack>
                </div>
            }
        </FluentStack>
    </FluentCard>

    <FluentCard Padding="@Padding.All4">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
            <h2>3. Sessions, Participant Dwell &amp; RustFS S3 Recordings</h2>
            @foreach (var s in _sessions)
            {
                <FluentCard Padding="@Padding.All3" @key="s.Id">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                            <strong>@s.Title — @s.RoomName</strong>
                            <span class="ruth-room-status-pill">@s.Status</span>
                            <small>Participants: @s.Participants.Count · Recordings: @s.Recordings.Count</small>
                        </FluentStack>
                        @foreach (var p in s.Participants)
                        {
                            <small @key="p.Id">
                                @p.DisplayName (@p.Role) — Dwell: @(p.CumulativeDwellSeconds)s · Qualified: @p.QualifiedForAttendance
                            </small>
                        }
                        @foreach (var rec in s.Recordings)
                        {
                            <small @key="rec.Id">
                                Recording [@rec.Status]: s3://@rec.StorageBucket/@rec.StorageObjectKey
                            </small>
                        }
                    </FluentStack>
                </FluentCard>
            }
        </FluentStack>
    </FluentCard>
</FluentStack>
