@page "/change-password"
@inject ICommandDispatcher CommandDispatcher
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Change Password — Ruth RMS</PageTitle>

<div class="ruth-onboarding-container">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <h1>Change Password</h1>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)"
                              AllowDismiss="true">
                @_statusMessage
            </FluentMessageBar>
        }

        <FluentCard Padding="@Padding.All4">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentTextInput Id="current-password"
                                 @bind-Value="_currentPassword"
                                 TextInputType="TextInputType.Password"
                                 Label="Current Password"
                                 Required="true"
                                 Width="100%" />

                <FluentTextInput Id="new-password"
                                 @bind-Value="_newPassword"
                                 TextInputType="TextInputType.Password"
                                 Label="New Password"
                                 Required="true"
                                 Width="100%" />

                <FluentTextInput Id="confirm-password"
                                 @bind-Value="_confirmPassword"
                                 TextInputType="TextInputType.Password"
                                 Label="Confirm New Password"
                                 Required="true"
                                 Width="100%" />

                <FluentButton Appearance="ButtonAppearance.Primary"
                              Disabled="@_isSubmitting"
                              Loading="@_isSubmitting"
                              OnClick="@SubmitAsync">
                    Update Password
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentStack>
</div>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isSubmitting;
    private bool _isError;
    private string? _statusMessage;

    private async Task SubmitAsync()
    {
        _statusMessage = null;
        _isError = false;

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _isError = true;
            _statusMessage = "New password and confirmation do not match.";
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var rawSub = authState.User.FindFirst("sub")?.Value
            ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(rawSub, out var userId))
        {
            _isError = true;
            _statusMessage = "Sign in to change your password.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await CommandDispatcher.SendAsync<ChangePasswordCommand, bool>(
                new ChangePasswordCommand(userId, _currentPassword, _newPassword)
            );
            if (result.IsSuccess)
            {
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                _statusMessage = "Password updated successfully. Other API sessions have been revoked.";
            }
            else
            {
                _isError = true;
                _statusMessage = result.PrimaryError.Description;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
