<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="@AssetUrl("_content/Microsoft.FluentUI.AspNetCore.Components/css/default-fuib.css")" />
    <link rel="stylesheet" href="@AssetUrl("Ruth.Host.styles.css")" />
    <link rel="stylesheet" href="@AssetUrl("app.css")" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@AssetUrl("_framework/blazor.web.js")"></script>
</body>

</html>

@code {
    private string AssetUrl(string path) => $"/{Assets[path].TrimStart('/')}";
}
