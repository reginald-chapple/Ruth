{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RuthDatabase": "Host=localhost;Port=5432;Database=ruth",
    "Redis": "localhost:6379"
  },
  "Persistence": {
    "Rls": {
      "UseNonSuperuserAppRole": true,
      "MigratorRoleName": "ruth_migrator",
      "AppRoleName": "ruth_app"
    }
  },
  "Tenancy": {
    "SandboxBaseDomain": "sandbox.localhost",
    "PlatformOperatorHost": "ops.localhost",
    "PlatformSignupHosts": ["localhost", "signup.localhost"],
    "StripeMockMode": true
  },
  "Storage": {
    "RustFs": {
      "Endpoint": "http://localhost:9000",
      "BucketName": "ruth",
      "HealthCheckPath": "/health",
      "HealthCheckTimeoutSeconds": 3
    }
  },
  "Observability": {
    "ServiceName": "Ruth.Host",
    "OtlpEndpoint": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "HealthChecks": {
    "TimeoutSeconds": 3
  },
  "Bootstrap": {
    "AutoMigrateAndSeed": false
  }
}
