{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RuthDatabase": "Host=localhost;Port=5432;Database=ruth",
    "Redis": "localhost:6379"
  },
  "Storage": {
    "RustFs": {
      "Endpoint": "http://localhost:9000",
      "BucketName": "ruth",
      "HealthCheckPath": "/health",
      "HealthCheckTimeoutSeconds": 3
    }
  },
  "Observability": {
    "ServiceName": "Ruth.Host",
    "OtlpEndpoint": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "HealthChecks": {
    "TimeoutSeconds": 3
  },
  "Bootstrap": {
    "AutoMigrateAndSeed": false
  }
}
