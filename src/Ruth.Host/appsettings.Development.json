{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "RuthDatabase": "Host=localhost;Port=5432;Database=ruth;Username=ruth;Password=ruth_secret",
    "Redis": "localhost:6379"
  },
  "Persistence": {
    "Rls": {
      "UseNonSuperuserAppRole": true,
      "MigratorRoleName": "ruth_migrator",
      "AppRoleName": "ruth_app",
      "AppRolePassword": "ruth_app_rls_local_dev_pw"
    }
  },
  "Storage": {
    "RustFs": {
      "Endpoint": "http://localhost:9000",
      "BucketName": "ruth",
      "AccessKey": "rustfsadmin",
      "SecretKey": "rustfsadmin"
    }
  },
  "OpenApi": {
    "Enabled": true
  }
}
