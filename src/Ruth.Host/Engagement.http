@host = http://localhost:5000
@token = REPLACE_WITH_BEARER_TOKEN

### W5-S1: List Engagement Pipeline Types
GET {{host}}/api/engagement/pipelines?activeOnly=true
Authorization: Bearer {{token}}

### W5-S1: Create Engagement Pipeline Type
POST {{host}}/api/engagement/pipelines
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Volunteer & Member Onboarding",
  "slug": "volunteer-member-onboarding",
  "enableFutureFollowUp": true,
  "defaultFollowUpDays": 7,
  "daysUntilRequestIdle": 10,
  "requiresPlacementGroup": false,
  "isSequentialStageProgression": false,
  "stages": [
    { "name": "New Inquiry", "order": 0, "isInitial": true },
    { "name": "Coordinator Intro", "order": 1 },
    { "name": "Connected", "order": 2, "isTerminalCompleted": true }
  ],
  "activityTypes": [
    { "name": "Phone Call", "order": 0 },
    { "name": "Orientation Coffee", "order": 1 }
  ]
}

### W5-S1: Update Engagement Pipeline Type
PUT {{host}}/api/engagement/pipelines/00000000-0000-0000-0000-000000000501
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Volunteer & Member Onboarding",
  "slug": "volunteer-member-onboarding",
  "daysUntilRequestIdle": 14,
  "stages": [
    { "name": "New Inquiry", "order": 0, "isInitial": true },
    { "name": "Connected", "order": 1, "isTerminalCompleted": true }
  ]
}

### W5-S1: List Staff Engagement Opportunities
GET {{host}}/api/engagement/pipelines/opportunities
Authorization: Bearer {{token}}

### W5-S1: Create Engagement Opportunity
POST {{host}}/api/engagement/pipelines/opportunities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pipelineTypeId": "00000000-0000-0000-0000-000000000501",
  "name": "Youth Mentorship Intake",
  "slug": "youth-mentorship-intake",
  "publicSummary": "Mentor emerging community leaders.",
  "isActive": true,
  "isPublic": true
}

### W5-S1: Update Engagement Opportunity
PUT {{host}}/api/engagement/pipelines/opportunities/00000000-0000-0000-0000-000000000502
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pipelineTypeId": "00000000-0000-0000-0000-000000000501",
  "name": "Youth Mentorship Intake",
  "slug": "youth-mentorship-intake",
  "publicSummary": "Updated mentorship cohort summary.",
  "isActive": true,
  "isPublic": true
}

### W5-S1: Browse Public Opportunity Finder
GET {{host}}/api/engagement/public/opportunities?q=Mentor

### W5-S1: Get Public Opportunity by Slug
GET {{host}}/api/engagement/public/opportunities/youth-mentorship-intake

### W5-S1: Submit Public Opportunity Signup
POST {{host}}/api/engagement/public/signup
Content-Type: application/json

{
  "opportunityIdOrSlug": "youth-mentorship-intake",
  "firstName": "Jordan",
  "lastName": "Hayes",
  "email": "jordan.hayes@example.org",
  "mobilePhone": "+15552345678",
  "comments": "Available Tuesday evenings"
}

