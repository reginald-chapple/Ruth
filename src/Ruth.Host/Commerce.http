  "hourlyRate": 50.00,
  "flatCleaningOrSetupFee": 15.00,
  "memberHourlyRate": 25.00,
  "revenueAccountId": "00000000-0000-0000-0000-000000000001"
}

### Update Rentable Facility Resource
PUT {{host}}/api/commerce/bookings/resources/00000000-0000-0000-0000-000000000013
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Community Studio A",
  "slug": "community-studio-a",
  "resourceKind": "Studio",
  "coreLocationId": "00000000-0000-0000-0000-000000000012",
  "minDurationMinutes": 60,
  "maxDurationMinutes": 240,
  "slotIncrementMinutes": 60,
  "currencyCode": "USD",
  "hourlyRate": 55.00,
  "revenueAccountId": "00000000-0000-0000-0000-000000000001"
