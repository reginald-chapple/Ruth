@using Microsoft.AspNetCore.Components

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Subject</title>
</head>
<body style="margin:0;padding:24px;background-color:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">
    @if (!string.IsNullOrWhiteSpace(Preheader))
    {
        <div style="display:none;max-height:0;overflow:hidden;opacity:0;">@Preheader</div>
    }
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;">
        <tr>
            <td style="padding:24px 28px;background-color:#0f6cbd;color:#ffffff;">
                <div style="font-size:13px;letter-spacing:0.04em;text-transform:uppercase;opacity:0.9;">@OrganizationName</div>
                <h1 style="margin:8px 0 0;font-size:22px;line-height:1.3;font-weight:600;">@Heading</h1>
            </td>
        </tr>
        <tr>
            <td style="padding:28px;font-size:15px;line-height:1.6;color:#1f2937;">
                @if (!string.IsNullOrWhiteSpace(BodyHtml))
                {
                    @((MarkupString)BodyHtml)
                }
                else if (!string.IsNullOrWhiteSpace(BodyText))
                {
                    <p style="margin:0;">@BodyText</p>
                }
                @if (!string.IsNullOrWhiteSpace(ActionLabel) && IsSafeUrl(ActionUrl))
                {
                    <div style="margin-top:24px;">
                        <a href="@ActionUrl" style="display:inline-block;padding:12px 20px;background-color:#0f6cbd;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">@ActionLabel</a>
                    </div>
                }
            </td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(FooterText))
        {
            <tr>
                <td style="padding:18px 28px;background-color:#f9fafb;border-top:1px solid #e5e7eb;font-size:12px;line-height:1.5;color:#6b7280;">
                    @FooterText
                </td>
            </tr>
        }
    </table>
</body>
</html>

@code {
    /// <summary>Gets or sets the organization banner label.</summary>
    [Parameter]
    public string OrganizationName { get; set; } = "Ruth";

    /// <summary>Gets or sets the HTML document title / email subject.</summary>
    [Parameter]
    public string Subject { get; set; } = "Message";

    /// <summary>Gets or sets the hidden inbox preview preheader text.</summary>
    [Parameter]
    public string? Preheader { get; set; }

    /// <summary>Gets or sets the primary heading inside the email header.</summary>
    [Parameter]
    public string Heading { get; set; } = "Hello";

    /// <summary>Gets or sets optional plain-text body content (automatically HTML-encoded).</summary>
    [Parameter]
    public string? BodyText { get; set; }

    /// <summary>Gets or sets optional trusted/pre-rendered HTML body content (e.g., from IMergeTemplateEngine in Html mode).</summary>
    [Parameter]
    public string? BodyHtml { get; set; }

    /// <summary>Gets or sets the optional call-to-action button label.</summary>
    [Parameter]
    public string? ActionLabel { get; set; }

    /// <summary>Gets or sets the optional call-to-action link URL (must be http, https, mailto, or root-relative).</summary>
    [Parameter]
    public string? ActionUrl { get; set; }

    /// <summary>Gets or sets optional footer text.</summary>
    [Parameter]
    public string? FooterText { get; set; }

    private static bool IsSafeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        var trimmed = url.Trim();
        return trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith('/');
    }
}
