# =============================================================================
# White-Label Tax-Exempt Nonprofit SaaS — Local Environment Template
# Copy to .env (gitignored) and replace placeholder secrets before Production!
# =============================================================================

# --- PostgreSQL 18 (docker-compose.yml) ---
POSTGRES_PORT=5432
POSTGRES_DB=ruth
POSTGRES_USER=ruth
POSTGRES_PASSWORD=ruth_secret
RUTH_APP_DB_PASSWORD=ruth_app_rls_local_dev_pw

# --- Redis 8 (docker-compose.yml) ---
REDIS_PORT=6379

# --- RustFS S3-Compatible Object Storage (docker-compose.yml) ---
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# --- Multi-Tenant SaaS Host Routing & RLS Runtime ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__RuthDatabase=Host=localhost;Port=5432;Database=ruth;Username=ruth;Password=ruth_secret
Persistence__Rls__UseNonSuperuserAppRole=true
Persistence__Rls__AppRoleName=ruth_app
Persistence__Rls__AppRolePassword=ruth_app_rls_local_dev_pw
Tenancy__SandboxBaseDomain=sandbox.localhost
Tenancy__PlatformOperatorHost=ops.localhost
Tenancy__StripeMockMode=true
ConnectionStrings__Redis=localhost:6379
Storage__RustFs__Endpoint=http://localhost:9000
Storage__RustFs__BucketName=ruth
Storage__RustFs__AccessKey=rustfsadmin
Storage__RustFs__SecretKey=rustfsadmin
Authentication__Jwt__SigningKey=replace-with-a-unique-random-32-plus-character-secret-in-production
Bootstrap__AutoMigrateAndSeed=true
