# =============================================================================
# White-Label Tax-Exempt Nonprofit SaaS — Local Environment Template
# Copy to .env (gitignored) and replace placeholder secrets before Production!
# =============================================================================

# --- PostgreSQL 18 (docker-compose.yml — bound to 127.0.0.1) ---
POSTGRES_PORT=5432
POSTGRES_DB=ruth
POSTGRES_USER=ruth
POSTGRES_PASSWORD=ruth_secret
RUTH_MIGRATOR_DB_PASSWORD=ruth_migrator_local_dev_pw
RUTH_APP_DB_PASSWORD=ruth_app_rls_local_dev_pw

# --- Redis 8 (docker-compose.yml — authenticated & bound to 127.0.0.1) ---
REDIS_PORT=6379
REDIS_PASSWORD=ruth_redis_local_dev_pw

# --- RustFS S3-Compatible Object Storage (docker-compose.yml — bound to 127.0.0.1) ---
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET=ruth
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# --- Multi-Tenant SaaS Host Routing, RLS & Envelope Cryptography ---
RUTH_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__RuthDatabase=Host=127.0.0.1;Port=5432;Database=ruth;Username=ruth;Password=ruth_secret
Persistence__Rls__UseNonSuperuserAppRole=true
Persistence__Rls__MigratorRoleName=ruth_migrator
Persistence__Rls__AppRoleName=ruth_app
Persistence__Rls__AppRolePassword=ruth_app_rls_local_dev_pw
Tenancy__SandboxBaseDomain=sandbox.localhost
Tenancy__PlatformOperatorHost=ops.localhost
Tenancy__StripeMockMode=true
ConnectionStrings__Redis=127.0.0.1:6379,password=ruth_redis_local_dev_pw,abortConnect=false
Storage__RustFs__Endpoint=http://127.0.0.1:9000
Storage__RustFs__BucketName=ruth
Storage__RustFs__AccessKey=rustfsadmin
Storage__RustFs__SecretKey=rustfsadmin
Authentication__Jwt__SigningKey=replace-with-a-unique-random-32-plus-character-secret-in-production
Security__CredentialEncryption__ActiveKeyId=k1
Security__CredentialEncryption__MasterKey=replace-with-a-unique-random-32-plus-character-kek-in-production
Bootstrap__AutoMigrateAndSeed=true
